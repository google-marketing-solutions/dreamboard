# Copy to bulk-video-creator/backend/.env and fill in. Never commit the real .env.

# --- Core (same meaning as backend/app/.env-template) ---
PROJECT_ID=""
GCS_BUCKET=""
LOCATION="us-central1"
ENV="dev"
# When set, errors are returned as HTTP 200 with
# {"status_code": 500, "error_message": ...} for the NodeJS middleware.
# Leave empty to get real HTTP status codes (e.g. when testing in Swagger).
USE_AUTH_MIDDLEWARE=""

# --- Bulk ---
# Veo model: veo-3.1-generate-001 | veo-3.1-fast-generate-001 |
#            veo-3.0-generate-001 | veo-3.0-fast-generate-001
BULK_VIDEO_MODEL="veo-3.1-generate-001"
# Video length in seconds: 4, 6 or 8 (4 is the cheapest).
BULK_VIDEO_DURATION_SECS="4"
# Max data rows per sheet.
BULK_MAX_ROWS="100"
# Root folder of the bulks inside GCS_BUCKET.
BULK_GCS_PREFIX="bulk-video-creator"
# Max size of each downloaded seed image, in bytes (20 MB).
BULK_MAX_IMAGE_BYTES="20971520"
# Comma separated origins allowed for browser calls. No wildcard.
BULK_CORS_ORIGINS=""
# Local port for `python -m bulk_app.main`.
BULK_PORT="8000"
# Optional: path to backend/app if the repo layout is different.
# DREAMBOARD_CORE_PATH=""
